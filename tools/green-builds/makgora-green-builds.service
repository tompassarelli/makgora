[Unit]
Description=Install the newest green Mak'gora main under Maps/00-Makgora
Documentation=https://github.com/tompassarelli/makgora/blob/main/docs/commands/play.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.bun/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUNNER=%h/code/makgora/worktrees/green-builds-runner
ExecStartPre=/usr/bin/env git -C %h/code/makgora/main fetch -q origin main
ExecStartPre=/bin/sh -c 'test -d "$RUNNER" || git -C %h/code/makgora/main worktree add -q --detach "$RUNNER" origin/main'
ExecStartPre=/bin/sh -c 'git -C "$RUNNER" checkout -q --detach origin/main && cd "$RUNNER/ts" && bun install --frozen-lockfile'
WorkingDirectory=%h/code/makgora
ExecStart=/bin/sh -c 'cd "$RUNNER/ts" && exec bun wisp play --install-green ${SMOKE_PAIR:+--pair "$SMOKE_PAIR"}'
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=150min
