[Unit]
Description=Refresh Smashcraft's seven-day job timing baseline
ConditionUser=tom
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/share/north/bin:%h/.local/bin:%h/.bun/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/code/smashcraft/main/ts
ExecStart=/usr/bin/env bun scripts/jobWatchdog.ts --baseline
TimeoutStartSec=30min

