[Unit]
Description=Watch Smashcraft Autoland and farm job deadlines
ConditionUser=tom
Requires=smashcraft-job-watchdog-baseline.service
After=network-online.target smashcraft-job-watchdog-baseline.service
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/share/north/bin:%h/.local/bin:%h/.bun/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/code/smashcraft/main/ts
ExecStart=/usr/bin/env bun scripts/jobWatchdog.ts --apply
Restart=on-failure
RestartSec=20s

