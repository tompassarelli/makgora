[Unit]
Description=Build and install every Smashcraft main landing under Maps/00-Smashcraft
Documentation=https://github.com/tompassarelli/smashcraft/blob/main/docs/play.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.bun/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/code/smashcraft/worktrees/tom-build-watch/ts
ExecStartPre=/usr/bin/env git -C %h/code/smashcraft/worktrees/tom-build-watch fetch -q origin main
ExecStartPre=/usr/bin/env git -C %h/code/smashcraft/worktrees/tom-build-watch checkout -q --detach FETCH_HEAD
ExecStartPre=/usr/bin/env bun install --frozen-lockfile
ExecStart=/usr/bin/env bun scripts/tomBuildWatch.ts
Restart=on-failure
RestartSec=30
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=default.target
