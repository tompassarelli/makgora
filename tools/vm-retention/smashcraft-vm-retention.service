[Unit]
Description=Copy the farm VM's out and fidelity results here, verify them, prune the VM's old copies and warn on low VM disk
Documentation=https://github.com/tompassarelli/smashcraft/blob/main/tools/vm-retention/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/libexec/smashcraft-vm-retention.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=25min
