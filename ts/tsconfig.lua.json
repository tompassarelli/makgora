{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": [
      "lua-types/5.3"
    ],
    "rootDir": "src",
    "outDir": "build"
  },
  "include": [
    "src/game/core/math/meleeScalarMath.ts",
    "src/game/core/math/parityCorpus.ts",
    "src/game/host/entries/parityMain.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "tstl": {
    "luaTarget": "5.3",
    "luaBundle": "parity.lua",
    "luaBundleEntry": "src/game/host/entries/parityMain.ts",
    "noImplicitSelf": true,
    "noHeader": true,
    "luaPlugins": [
      {
        "name": "./node_modules/wisp/plugins/warcraft-numbers.ts"
      },
      {
        "name": "./node_modules/wisp/plugins/game-api.ts"
      }
    ]
  }
}
