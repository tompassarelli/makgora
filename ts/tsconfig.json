{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "incremental": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "..",
    "outDir": "build/typecheck-host",
    "tsBuildInfoFile": "build/typecheck-host.tsbuildinfo",
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "allowedUnstableApis": ["effect/process", "effect/FileSystem", "@effect/platform-bun/BunRuntime", "@effect/platform-bun/BunServices"]
      },
      {
        "name": "wisp/plugins/number-rules-service.cjs",
        "project": "./tsconfig.game.json"
      }
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "codegen/**/*.ts",
    "plugins/**/*.ts",
    "test/accept-map-profiles.test.ts",
    "test/button-sweep.test.ts",
    "test/fighter-marker.test.ts",
    "test/frame-tint.test.ts",
    "test/item-pickup-models.test.ts",
    "test/rifleman-removed.test.ts",
    "test/y-capture.test.ts",
    "test/y-strong.test.ts",
    "test/pause-screen.test.ts",
    "test/stage-load-card.test.ts",
    "test/dash-feet.test.ts",
    "test/illidan-gait.test.ts",
    "test/lan-pool-queue.test.ts",
    "test/costume-colors.test.ts",
    "test/melee-thresholds.test.ts",
    "test/headless.ts",
  "../references/melee-frame-data/fightcore-check.ts"
  ],
  "exclude": [
    "src/platform/**",
    "src/host/**",
    "src/game/ui/**",
    "src/game/render/**",
    "src/game/host/entries/parityMain.ts",
    "scripts/wisp/perfLua.ts",
    "scripts/wisp/memoryLua.ts",
    "scripts/wisp/handleBaselineLua.ts",
    "scripts/wisp/handleBaseline.ts",
    "scripts/wisp/memoryCensus.ts",
    "scripts/wisp/botMatch.ts",
    "scripts/wisp/censusProfile.ts"
  ]
}
