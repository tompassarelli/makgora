{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "incremental": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "build/typecheck-host",
    "tsBuildInfoFile": "build/typecheck-host.tsbuildinfo",
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "allowedUnstableApis": ["effect/process", "effect/FileSystem", "@effect/platform-bun/BunRuntime", "@effect/platform-bun/BunServices"]
      },
      {
        "name": "wisp/plugins/number-rules-service.cjs",
        "project": "./tsconfig.game.json"
      }
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "codegen/**/*.ts",
    "plugins/**/*.ts",
    "test/advantage-state.test.ts",
    "test/voice-trace.test.ts",
    "test/aerial-down-specials.test.ts",
    "test/zero-to-death.test.ts",
    "test/cpu-advantage.test.ts",
    "test/air-drift.test.ts",
    "test/cpu-field.test.ts",
    "test/cpu-defaults.test.ts",
    "test/dreadlord-shadow-hunter-gameplans.test.ts",
    "test/fighter-hide.test.ts",
    "test/native-capture.test.ts",
    "test/genre-envelope.test.ts",
    "test/headless.ts",
    "test/live-agency.test.ts",
    "test/map-edition.test.ts",
    "test/platform-advantage.test.ts",
    "test/playtest.test.ts",
    "test/powershield-reflect.test.ts",
    "test/projectile-rules.test.ts",
    "test/rifleman-blaster.test.ts",
    "test/tavern-gameplans.test.ts",
    "test/text-match.test.ts",
    "test/warden-spin.test.ts",
    "test/effect-visibility.test.ts"
  ],
  "exclude": [
    "src/platform/**",
    "src/host/**",
    "src/game/ui/**",
    "src/game/render/**",
    "src/game/host/entries/parityMain.ts",
    "scripts/wisp/perfLua.ts",
    "scripts/wisp/memoryLua.ts",
    "scripts/wisp/handleBaselineLua.ts",
    "scripts/wisp/handleBaseline.ts",
    "scripts/wisp/memoryCensus.ts",
    "scripts/wisp/memoryCensus.tests.ts",
    "scripts/wisp/botMatch.ts",
    "scripts/wisp/censusProfile.ts"
  ]
}
