{
  "extends": "./tsconfig.lua.json",
  "compilerOptions": {
    "sourceMap": true
  },
  "include": [
    "src/game/core/*.ts",
    "src/game/core/math/*.ts",
    "node_modules/wisp/src/natives/warcraft.d.ts",
    "src/platform/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.tests.ts",
    "src/game/core/math/parityCorpus.ts",
    "src/platform/airCutoffProbe.ts",
    "src/platform/physicsProbeMain.ts",
    "src/platform/frameCostMain.ts",
    "src/platform/integrityMain.ts",
    "src/platform/playableMain.ts",
    "src/platform/soakPlayableMain.ts",
    "src/platform/soakIntegrityMain.ts",
    "src/platform/nativePerfMain.ts",
    "src/platform/stackDemo.ts",
    "src/platform/stackTraceMain.ts",
    "src/platform/damageBlendProbeMain.ts",
    "src/platform/damageBlendProbeModels.ts"
  ],
  "tstl": {
    "luaBundle": "map.lua",
    "luaBundleEntry": "src/platform/devMain.ts",
    "luaPlugins": [
      {
        "name": "./node_modules/wisp/plugins/warcraft-numbers.ts"
      },
      {
        "name": "./plugins/source-version.ts"
      }
    ]
  }
}
