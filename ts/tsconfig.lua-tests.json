{
  "extends": "./tsconfig.lua.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build/lua-tests"
  },
  "include": [
    "src/game/**/*.ts",
    "src/**/*.tests.ts",
    "node_modules/wisp/src/natives/warcraft.d.ts",
    "test/lua/*.ts",
    "scripts/wisp/memoryCensus.tests.ts"
  ],
  "tstl": {
    "luaBundle": "tests.lua",
    "luaBundleEntry": "test/lua/entry.ts"
  }
}
